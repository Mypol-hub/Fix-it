-- 1. PUBLIC READ HOOK: Allow public links to download images from ITEM-IMAGES
CREATE POLICY "Storage public read link"
ON storage.objects
FOR SELECT
USING (bucket_id = 'ITEM-IMAGES');

-- 2. CLIENT UPLOAD HOOK: Allow guests and users to upload repair photos
CREATE POLICY "Storage public upload link"
ON storage.objects
FOR INSERT
WITH CHECK (bucket_id = 'ITEM-IMAGES');

-- 3. ADMIN MASTER OVERRIDE: Give your exact admin login full master power over bucket files
CREATE POLICY "Storage admin master link"
ON storage.objects
FOR ALL
USING (
    bucket_id = 'ITEM-IMAGES'
    AND (auth.jwt() ->> 'email'::text) = 'khalil_repair@gmail.com'
);
