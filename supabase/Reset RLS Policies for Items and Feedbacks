-- 1. Force Reset the items table RLS state
ALTER TABLE public.items ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "Public completely open insert items" ON public.items;
CREATE POLICY "Public completely open insert items"
ON public.items FOR INSERT
WITH CHECK (true);

DROP POLICY IF EXISTS "Public completely open select items" ON public.items;
CREATE POLICY "Public completely open select items"
ON public.items FOR SELECT
USING (true);


